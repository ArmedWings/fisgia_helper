# BARS.Education Client Environment Configuration Example
BARS_BASE_URL=your_url_of_BARS
SSUZ_SESSIONID=your_ssuz_sessionid_cookie_here
CSRFTOKEN=your_csrftoken_cookie_here

# BARS Filters Configuration
# BARS_PERIOD_ID - id приемной кампании (например, 41). Если пустое - запрашивается с сервера
BARS_PERIOD_ID=41
# BARS_LIMIT - Количество выгружаемых записей за один запрос
BARS_LIMIT=25
# BARS_START - Смещение начального индекса записи
BARS_START=0

# Расширенные фильтры поиска (если поле пустое — запрос отправляется без него)
# BARS_FILTER / filter - Общий поиск (например, ФИО абитуриента)
BARS_FILTER=

# BARS_FILTER_1 / filter_1 - Начало периода (формат dd.mm.yyyy, преобразуется в yyyy-mm-ddT00:00:00)
BARS_FILTER_1=

# BARS_FILTER_2 / filter_2 - Конец периода (формат dd.mm.yyyy, преобразуется в yyyy-mm-ddT00:00:00)
BARS_FILTER_2=

# BARS_SORT / sort - Поле сортировки (по умолчанию: date)
BARS_SORT=date

# BARS_DIR / dir - Порядок сортировки: DESC (по убыванию) или ASC (по возрастанию) (по умолчанию: DESC)
BARS_DIR=DESC

